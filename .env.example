# For Docker or a locally installed PostgreSQL server
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
DATABASE_URL=postgresql://accounts:change-me@localhost:5432/accounts
# Required first-admin credentials; no built-in production password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Optional: business calendar for default dates, and which proxies may set X-Forwarded-For
# BUSINESS_TIME_ZONE=Asia/Kolkata
# TRUST_PROXY=loopback, uniquelocal
# Keep false for real books. Demo seed is opt-in and requires an empty database.
DEMO_MODE=false
SEED_DEMO=false

