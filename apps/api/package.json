{
  "name": "@accounts/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-path=src --import tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "node --import tsx src/migrate.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5",
    "@types/node": "^24",
    "@types/pg": "^8",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
